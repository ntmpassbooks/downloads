# ==============================================================================
# NTM Passbook Backend Environment Configuration Template
# Duplicate this file to .env.production, .env.development, or .env.staging
# DO NOT commit files containing actual secrets to version control!
# ==============================================================================

# Application Environment: 'production' | 'development' | 'staging' | 'test'
NODE_ENV=production

# Server Port
PORT=5000

# SQLite Database Storage Path
# Production default: ./data/ntm_prod.sqlite
# Development default: ./data/ntm_dev.sqlite
# Test default: ./data/ntm_test.sqlite
DB_PATH=./data/ntm_prod.sqlite

# Session Secret (REQUIRED: Cryptographically random string with at least 32 characters)
# Example generation: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_hex_string_at_least_32_characters_long

# Session Expiry in Hours (default: 720 = 30 days)
SESSION_EXPIRY_HOURS=720

# CORS Allowed Origins (Comma-separated for multiple origins)
# In production, specify the exact HTTPS domain(s) of your frontend/PWA deployment
CORS_ORIGIN=https://passbook.example.com

# Internal Application Cryptographic Keys (REQUIRED: Minimum 32 characters each)
# Generate using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PIN_ENCRYPTION_KEY=replace_with_a_secure_random_hex_string_at_least_32_chars_long
BANK_ENCRYPTION_KEY=replace_with_a_secure_random_hex_string_at_least_32_chars_long

# Optional Payment Gateway Configuration (Production Placeholders - Configure only on live server)
# DO NOT commit real keys to version control!
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Notification Provider Configuration (Production Placeholders)
FCM_SERVER_KEY=

# Optional Firebase Admin SDK Configuration (Batch 7A: Custom Token Generation)
# Required only if issuing Firebase Custom Tokens on the backend
FIREBASE_PROJECT_ID=ntm-passbook
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

