# NTM Passbook Android Release Signing Template (EXAMPLE ONLY)
# ======================================================================
# INSTRUCTIONS:
# For local release signing, copy this file to 'keystore.properties' (which is gitignored).
# Alternatively, set these Environment Variables in your secure CI/CD build environment:
#   ANDROID_KEYSTORE_PATH
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD
#
# IMPORTANT:
# DO NOT commit real passwords, keys, or keystore files into version control!
# ======================================================================

storeFile=/absolute/path/to/your/release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
