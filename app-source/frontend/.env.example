# NTM Passbook Frontend Environment Configuration
# For local browser development with Vite proxy, leave empty or unset (defaults to relative /api)
# VITE_API_URL=

# For mobile apps (Android/iOS) or standalone staging/production builds:
# Set to the authoritative HTTPS backend domain without trailing slash:
# VITE_API_URL=https://api.yourmandal.org

# Optional Firebase Web Client Configuration (Batch 7B: Firebase Auth Synchronization)
# Values are public client configuration parameters from the Firebase Console Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ntm-passbook
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
